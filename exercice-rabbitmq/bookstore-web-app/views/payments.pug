extends layout

block content
  h1 Payments

  if error
    p.error= error

  if payments && payments.length
    ul
      each payment in payments
        li #{payment.orderRef} - #{payment.amount} (#{payment.method})
  else
    p Aucun paiement pour le moment.

  h2 Add Payment:
  form(method='post', action='/payments')
    div
      label(for='orderRef') Order ref
      input#orderRef(type='text', name='orderRef', required)
    div
      label(for='amount') Amount
      input#amount(type='number', name='amount', min='0', step='0.01', required)
    div
      label(for='method') Method
      input#method(type='text', name='method', required)
    button(type='submit') Submit
